APP_NAME=Agency Overlord
DATABASE_PATH=./data/agency_overlord.db
DEMO_MODE=1
SESSION_SECRET=replace-with-64-random-characters
SETUP_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000

# Optional AI orchestration. The app works without this key using its deterministic strategy engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Keep disabled until real provider adapters, OAuth credentials, client authorization, QA, and budget controls are configured.
ALLOW_LIVE_PUBLISH=0

# Provider credentials belong in a secret manager/environment variables, never in source control.
META_CLIENT_ID=
META_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
STRIPE_SECRET_KEY=
